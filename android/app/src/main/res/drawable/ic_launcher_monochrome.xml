<!--
  Astrology Nova launcher icon — monochrome / themed-icon layer (Android 13+).
  Original artwork for Astrology Nova, GPLv3 with the rest of the repository.

  The OS tints this layer one flat colour and uses only its alpha, so the
  gradients and the glow that carry the full-colour mark are useless here and
  the two shapes have to survive on silhouette alone. The flare is pulled in to
  radius 23 and the ring left at its full span, opening a clear gap between the
  star's points and the band — without it the two merge into a blob at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-22">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.6"
            android:pathData="M22,54a32,11.5 0,1 0,64 0a32,11.5 0,1 0,-64 0z" />
    </group>
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,31 Q59,49.5 77,54 Q59,58.5 54,77 Q49,58.5 31,54 Q49,49.5 54,31 Z" />
</vector>
